#!/system/bin/sh
# SmoothPlay - @arqzey
DATA=${SP_DATA:-/data/adb/smoothplay}
SYS=${SP_SYS:-}
CONF=$DATA/config
GAMES=$DATA/games.list
ORIG=$DATA/original.state
LOG=$DATA/smoothplay.log
PIDF=$DATA/daemon.pid
ACTIVE=$DATA/active
ZEN=$DATA/zen.prev
DISP=$DATA/display.prev
DSP=$DATA/downscale.pct
INGAME=$DATA/ingame
GAMERES=$DATA/games.res
TH_SVC=$DATA/thermal.svcs
TH_MODE=$DATA/thermal.modes
NLAST=$DATA/notify.last
NREQ=$DATA/notify.req
MODDIR=${0%/*}/..
SDK=$(getprop ro.build.version.sdk)
BOOTID=$(cat "$SYS/proc/sys/kernel/random/boot_id" 2>/dev/null)
LOGO_T=/data/local/tmp/smoothplay_logo.png
ICON_T=/data/local/tmp/smoothplay_icon.png

mkdir -p "$DATA"; touch "$GAMES" "$GAMERES"
if [ ! -f "$CONF" ]; then
cat > "$CONF" <<EOC
PROFILE="daily"
AUTO_SWITCH="1"
GAME_DND="0"
REFRESH_DAILY=""
REFRESH_GAME=""
POLL="4"
EOC
fi
load() {
  . "$CONF"
  : "${NOTIFY:=1}" "${THERMAL_GUARD:=50}"
  : "${SWAP_GAME:=40}" "${VFS_GAME:=50}" "${UILANG:=en}"
}
load

log() {
  echo "$(date '+%m-%d %H:%M:%S') $*" >> "$LOG"
  if [ "$(wc -c < "$LOG")" -gt 200000 ]; then
    tail -n 200 "$LOG" > "$LOG.t"; mv "$LOG.t" "$LOG"
  fi
}

isnum()  { case "$1" in ""|*[!0-9]*) return 1;; esac; return 0; }
okpkg()  { case "$1" in ""|*[!A-Za-z0-9_.]*) return 1;; esac; return 0; }
inlist() { v=$1; shift; for x in "$@"; do [ "$x" = "$v" ] && return 0; done; return 1; }
w()      { [ -w "$1" ] && echo "$2" > "$1" 2>/dev/null; }
sput()   { settings put "$@" </dev/null; }
sget()   { settings get "$@" </dev/null; }

setconf() {
  grep -v "^$1=" "$CONF" > "$CONF.t"
  echo "$1=\"$2\"" >> "$CONF.t"
  mv "$CONF.t" "$CONF"
}

meminfo() {
  while read -r k v u; do
    [ "$k" = "$1:" ] && echo $((v / 1024)) && break
  done < "$SYS/proc/meminfo"
}

# ---------- hardware lookups ----------
cpu_avail() {
  for f in "$SYS"/sys/devices/system/cpu/cpufreq/policy*/scaling_available_governors; do
    [ -r "$f" ] && { tr -d '[]' < "$f"; return 0; }
  done
}
gpu_gov_path() {
  for g in "$SYS"/sys/class/kgsl/kgsl-3d0/devfreq/governor \
           "$SYS"/sys/class/devfreq/*kgsl*/governor \
           "$SYS"/sys/class/devfreq/*gpu*/governor \
           "$SYS"/sys/class/devfreq/*mali*/governor; do
    [ -f "$g" ] && { echo "$g"; return 0; }
  done
}
gpu_avail() {
  g=$(gpu_gov_path); [ -n "$g" ] && tr -d '[]' < "${g%/*}/available_governors" 2>/dev/null
}
tcp_avail() { cat "$SYS/proc/sys/net/ipv4/tcp_available_congestion_control" 2>/dev/null; }
batt_temp() { [ -r "$SYS/sys/class/power_supply/battery/temp" ] && echo $(( $(cat "$SYS/sys/class/power_supply/battery/temp") / 10 )); }

# ---------- baseline ----------
backup() {
  if [ ! -f "$ORIG" ]; then
    : > "$ORIG"
    for k in window_animation_scale transition_animation_scale animator_duration_scale; do
      echo "S|global|$k|$(sget global $k)" >> "$ORIG"
    done
    for k in min_refresh_rate peak_refresh_rate; do
      echo "S|system|$k|$(sget system $k)" >> "$ORIG"
    done
    for f in "$SYS"/sys/devices/system/cpu/cpufreq/policy*/scaling_governor \
             "$SYS/proc/sys/vm/swappiness" "$SYS/proc/sys/vm/vfs_cache_pressure" \
             "$SYS/proc/sys/net/ipv4/tcp_congestion_control"; do
      [ -r "$f" ] && echo "F|$f|$(cat "$f")" >> "$ORIG"
    done
    log "baseline saved"
  fi
  # entries added in later versions (also for baselines saved by older ones)
  g=$(gpu_gov_path)
  if [ -n "$g" ] && ! grep -qF "F|$g|" "$ORIG"; then echo "F|$g|$(cat "$g")" >> "$ORIG"; fi
}

restore_sys() {
  [ -f "$ORIG" ] || return 0
  grep '^F|' "$ORIG" | while IFS='|' read -r t f v; do w "$f" "$v"; done
}

restore_S() {
  l=$(grep "^S|$1|$2|" "$ORIG" 2>/dev/null | head -n 1)
  [ -z "$l" ] && return 0
  v=${l##*|}
  if [ "$v" = "null" ]; then settings delete "$1" "$2" </dev/null; else sput "$1" "$2" "$v"; fi
}

restore_all() {
  thermal_enable
  ds_reset
  [ -f "$ORIG" ] || { echo "No baseline saved, nothing to restore"; return 0; }
  restore_sys
  grep '^S|' "$ORIG" | while IFS='|' read -r t ns k v; do restore_S "$ns" "$k"; done
  dnd_restore
  load
  rm -f "$ACTIVE"
  setconf AUTO_SWITCH 0
  log "restored to defaults"
  notify_state
  echo "Settings restored. Auto-switch turned off."
}

# ---------- tweaks ----------
set_gov() {
  for d in "$SYS"/sys/devices/system/cpu/cpufreq/policy*; do
    [ -f "$d/scaling_available_governors" ] || continue
    inlist "$1" $(tr -d '[]' < "$d/scaling_available_governors") && w "$d/scaling_governor" "$1"
  done
  return 0
}
set_gpu_gov() {
  g=$(gpu_gov_path); [ -n "$g" ] || return 0
  inlist "$1" $(gpu_avail) && w "$g" "$1"
  return 0
}
anim()        { for k in window_animation_scale transition_animation_scale animator_duration_scale; do sput global $k "$1"; done; }
refresh_set() { sput system min_refresh_rate "$1"; sput system peak_refresh_rate "$2"; }
dnd_on()      { [ -f "$ZEN" ] || sget global zen_mode > "$ZEN"; sput global zen_mode 1; }
dnd_restore() {
  [ -f "$ZEN" ] || return 0
  z=$(cat "$ZEN"); { [ "$z" = "null" ] || [ -z "$z" ]; } && z=0
  sput global zen_mode "$z"; rm -f "$ZEN"
}

# --- per-game resolution: games.res holds "package=percent" lines (missing = native)
game_res() { r=$(sed -n "s/^$(echo "$1" | sed 's/\./\\./g')=//p" "$GAMERES" | head -n 1); isnum "$r" && echo "$r" || echo 100; }

# --- resolution downscale (wm size + wm density, scaled together so the UI keeps its layout)
wm_get() { wm "$1" </dev/null 2>/dev/null | sed -n "s/^$2: *//p" | head -n 1; }

ds_reset() {
  [ -f "$DISP" ] || return 0
  os=$(sed -n 's/^size=//p' "$DISP"); od=$(sed -n 's/^density=//p' "$DISP")
  case "$os" in *[!0-9x]*) os="";; esac
  case "$od" in *[!0-9]*) od="";; esac
  if [ -n "$os" ]; then wm size "$os" </dev/null >/dev/null 2>&1; else wm size reset </dev/null >/dev/null 2>&1; fi
  if [ -n "$od" ]; then wm density "$od" </dev/null >/dev/null 2>&1; else wm density reset </dev/null >/dev/null 2>&1; fi
  rm -f "$DISP" "$DSP"
  log "downscale reset to 100%"
}

ds_apply() {
  p=${1:-100}
  isnum "$p" || return 1
  [ "$p" -ge 100 ] && { ds_reset; return 0; }
  [ "$p" -lt 30 ] && p=30
  ps=$(wm_get size "Physical size"); pd=$(wm_get density "Physical density")
  pw=${ps%x*}; ph=${ps#*x}
  if ! { isnum "$pw" && isnum "$ph" && isnum "$pd"; }; then log "downscale: cannot read display info"; return 1; fi
  nw=$(( (pw * p / 100 + 1) / 2 * 2 )); nh=$(( (ph * p / 100 + 1) / 2 * 2 ))
  nd=$(( pd * p / 100 )); [ "$nd" -lt 72 ] && nd=72
  if [ ! -f "$DISP" ]; then
    printf 'size=%s\ndensity=%s\n' "$(wm_get size 'Override size')" "$(wm_get density 'Override density')" > "$DISP"
  fi
  [ "$(wm_get size 'Override size')" = "${nw}x${nh}" ] || wm size "${nw}x${nh}" </dev/null >/dev/null 2>&1
  [ "$(wm_get density 'Override density')" = "$nd" ] || wm density "$nd" </dev/null >/dev/null 2>&1
  echo "$p" > "$DSP"
  log "downscale ${p}% (${nw}x${nh} @ ${nd}dpi)"
  return 0
}

# --- thermal: stop init.svc.*thermal* services via resetprop, then hide temp sensors
# Same flow as the classic thermal-kill script, reversible, and non-blocking
# (the sleeps run in the background so the WebUI toggle returns immediately).
TH_BG=$DATA/thermal.bg
th_active() { [ -f "$TH_SVC" ] && [ "$(sed -n 1p "$TH_SVC")" = "$BOOTID" ]; }

th_list() {  # running thermal services, one per line
  { command -v resetprop >/dev/null 2>&1 && resetprop || getprop; } 2>/dev/null \
    | sed -n 's/^\[init\.svc\.\([^]]*thermal[^]]*\)\]: \[running\]$/\1/p'
}

thermal_disable() {
  th_active && return 0
  rm -f "$TH_SVC" "$TH_MODE"
  echo "$BOOTID" > "$TH_SVC"; : > "$TH_MODE"
  for s in $(th_list); do
    case "$s" in ""|*[!A-Za-z0-9_.-]*) continue;; esac
    echo "$s" >> "$TH_SVC"
  done
  ns=$(( $(grep -c . "$TH_SVC") - 1 ))
  nt=$(find "$SYS/sys/devices/virtual/thermal" -name temp -type f 2>/dev/null | grep -c .)
  if [ "$ns" -le 0 ] && [ "$nt" -le 0 ]; then rm -f "$TH_SVC" "$TH_MODE"; return 1; fi
  (
    sed 1d "$TH_SVC" | while read -r s; do
      stop "$s" </dev/null >/dev/null 2>&1
      sleep "${TH_DELAY:-10}"
      command -v resetprop >/dev/null 2>&1 && resetprop -n "init.svc.$s" stopped
    done
    sleep "${TH_DELAY:-10}"
    find "$SYS/sys/devices/virtual/thermal" -name temp -type f 2>/dev/null | while IFS= read -r f; do
      m=$(stat -c %a "$f" 2>/dev/null); [ -n "$m" ] || continue
      echo "$m|$f" >> "$TH_MODE"; chmod 000 "$f"
    done
    log "thermal disabled: services stopped, sensor files hidden"
    rm -f "$TH_BG"
  ) >/dev/null 2>&1 </dev/null &
  echo $! > "$TH_BG"
  log "thermal disabling: $ns service(s), $nt sensor file(s)"
  return 0
}

thermal_enable() {
  # cancel a disable that is still running in the background
  if [ -f "$TH_BG" ]; then kill "$(cat "$TH_BG")" 2>/dev/null; rm -f "$TH_BG"; fi
  [ -f "$TH_SVC" ] || return 0
  if [ "$(sed -n 1p "$TH_SVC")" = "$BOOTID" ] && [ -f "$TH_MODE" ]; then
    while IFS='|' read -r m f; do
      case "$m" in ""|*[!0-7]*) continue;; esac
      case "$m" in 0|00|000) m=444;; esac
      [ -e "$f" ] && chmod "$m" "$f"
    done < "$TH_MODE"
  fi
  sed 1d "$TH_SVC" | while read -r s; do
    case "$s" in ""|*[!A-Za-z0-9_.-]*) continue;; esac
    start "$s" </dev/null >/dev/null 2>&1
    command -v resetprop >/dev/null 2>&1 && resetprop -n "init.svc.$s" running
  done
  rm -f "$TH_SVC" "$TH_MODE"
  log "thermal restored"
  return 0
}

thermal_guard() {
  th_active && [ "$THERMAL_GUARD" -gt 0 ] || return 0
  bt=$(batt_temp); isnum "$bt" || return 0
  if [ "$bt" -ge "$THERMAL_GUARD" ]; then
    thermal_enable; load
    log "thermal guard: battery ${bt}C >= ${THERMAL_GUARD}C, thermal restored"
    t="Thermal protection restored: battery ${bt}C reached the ${THERMAL_GUARD}C limit"
    notify "$t" && echo "$t" > "$NLAST"
  fi
}

# ---------- profiles ----------
p_daily() {
  restore_sys
  anim 0.7
  if [ -n "$REFRESH_DAILY" ]; then
    refresh_set 60 "$REFRESH_DAILY"
  else
    for k in min_refresh_rate peak_refresh_rate; do restore_S system $k; done
  fi
  dnd_restore
  [ -n "$CPU_GOV_DAILY" ] && set_gov "$CPU_GOV_DAILY"
  [ -n "$GPU_GOV_DAILY" ] && set_gpu_gov "$GPU_GOV_DAILY"
  ds_reset  # Daily / normal use is always native resolution
}

p_game() {
  restore_sys
  set_gov "${CPU_GOV_GAME:-performance}"
  [ -n "$GPU_GOV_GAME" ] && set_gpu_gov "$GPU_GOV_GAME"
  w "$SYS/proc/sys/vm/swappiness" "$SWAP_GAME"
  w "$SYS/proc/sys/vm/vfs_cache_pressure" "$VFS_GAME"
  if [ -n "$TCP_GAME" ]; then
    inlist "$TCP_GAME" $(tcp_avail) && w "$SYS/proc/sys/net/ipv4/tcp_congestion_control" "$TCP_GAME"
  else
    inlist bbr $(tcp_avail) && w "$SYS/proc/sys/net/ipv4/tcp_congestion_control" bbr
  fi
  anim 0.5
  [ -n "$REFRESH_GAME" ] && refresh_set "$REFRESH_GAME" "$REFRESH_GAME"
  [ "$GAME_DND" = "1" ] && dnd_on
  # per-game resolution, only while that listed game is detected in the foreground
  gp=$(cat "$INGAME" 2>/dev/null)
  if [ -n "$gp" ]; then ds_apply "$(game_res "$gp")"; else ds_reset; fi
}

apply() {
  load; backup
  case "$1" in
    daily) p_daily;;
    game)  p_game;;
    *) return 1;;
  esac
  echo "$1" > "$ACTIVE"
  log "active profile: $1"
  notify_state
  return 0
}

gmode() { [ "${SDK:-0}" -ge 31 ] && cmd game mode "$1" "$2" >/dev/null 2>&1; return 0; }

# ---------- status notification (small logo, replaced in place) ----------
_add() { out="${out:+$out | }$1"; }

state_text() {
  load; out=""
  a=$(cat "$ACTIVE" 2>/dev/null)
  id=0; [ "$UILANG" = "id" ] && id=1
  case "$a" in
    game)  [ $id = 1 ] && _add "Profil Game"  || _add "Game profile";;
    daily) [ $id = 1 ] && _add "Profil Daily" || _add "Daily profile";;
  esac
  r=""; cg=""; gg=""
  [ "$a" = game ] && { r=$REFRESH_GAME; cg=$CPU_GOV_GAME; gg=$GPU_GOV_GAME; }
  [ "$a" = daily ] && { r=$REFRESH_DAILY; cg=$CPU_GOV_DAILY; gg=$GPU_GOV_DAILY; }
  [ -n "$r" ] && _add "${r} Hz"
  [ -n "$cg" ] && _add "CPU $cg"
  [ -n "$gg" ] && _add "GPU $gg"
  [ "$a" = game ] && [ "$GAME_DND" = "1" ] && _add "DND"
  p=$(cat "$DSP" 2>/dev/null)
  isnum "$p" && [ "$p" -lt 100 ] && _add "Downscale ${p}%"
  if th_active; then [ $id = 1 ] && _add "Thermal MATI" || _add "Thermal OFF"; fi
  if [ -z "$out" ]; then [ $id = 1 ] && out="Siaga" || out="Standby"; fi
  echo "$out"
}

notify() {  # text -> posts/replaces one notification using the module logo
  mkdir -p /data/local/tmp 2>/dev/null
  cp -f "$MODDIR/webroot/icon.png" "$ICON_T" 2>/dev/null
  chmod 644 "$ICON_T" 2>/dev/null; rm -f "$LOGO_T" 2>/dev/null
  TO=""; command -v timeout >/dev/null 2>&1 && TO="timeout 10"
  ti="SmoothPlay is active"; [ "$UILANG" = "id" ] && ti="SmoothPlay aktif"
  n1="cmd notification post -t '$ti' -i file://$ICON_T 'SmoothPlay' '$1'"
  n2="cmd notification post -t '$ti' 'SmoothPlay' '$1'"
  for c in "$n1" "$n2"; do
    o=$($TO su -lp 2000 -c "$c" 2>&1 </dev/null) && return 0
    o2=$($TO sh -c "$c" 2>&1 </dev/null) && return 0
  done
  log "notify failed: $(echo "$o $o2" | tr '\n' ' ' | cut -c1-160)"
  return 1
}

# leave a request for the daemon; true if it picked it up, false if nobody did (caller posts itself)
notify_req() {
  echo req > "$NREQ"
  i=0; while [ -f "$NREQ" ] && [ "$i" -lt 8 ]; do sleep 0.5; i=$((i+1)); done
  [ -f "$NREQ" ] || return 0
  rm -f "$NREQ"; return 1
}

notify_state() {  # [force]
  load
  [ "$NOTIFY" = "1" ] || [ "$1" = "force" ] || return 0
  # Posting works from the daemon's own context (that is why it appeared after a reboot),
  # so a WebUI/CLI call only leaves a request and the daemon posts it within a second.
  if [ "$(cat "$PIDF" 2>/dev/null)" != "$$" ] && daemon_alive && notify_req; then return 0; fi
  [ "$(cat "$PIDF" 2>/dev/null)" != "$$" ] && set -- force   # a tap from the WebUI/CLI always re-posts
  t=$(state_text)
  [ "$1" != "force" ] && [ "$(cat "$NLAST" 2>/dev/null)" = "$t" ] && return 0
  notify "$t" && echo "$t" > "$NLAST"
  return 0
}

# ---------- foreground app detection ----------
fg_pkg() {
  l=$(dumpsys window 2>/dev/null | grep -m1 mCurrentFocus)
  [ -z "$l" ] && l=$(dumpsys activity activities 2>/dev/null | grep -m1 -E 'topResumedActivity|ResumedActivity')
  echo "$l" | sed -n 's/.* \([A-Za-z0-9_.]*\)\/[^ ]*.*/\1/p'
}

daemon_alive() {  # the pid must be alive AND really be a smoothplay process (pids get reused after reboot)
  [ -f "$PIDF" ] || return 1
  dp=$(cat "$PIDF" 2>/dev/null); isnum "$dp" || return 1
  kill -0 "$dp" 2>/dev/null || return 1
  [ "$dp" = "$$" ] && return 0
  tr '\0' ' ' < "/proc/$dp/cmdline" 2>/dev/null | grep -q smoothplay
}

daemon() {
  if daemon_alive && [ "$(cat "$PIDF")" != "$$" ]; then exit 0; fi
  echo $$ > "$PIDF"
  log "daemon started (pid $$)"
  load
  rm -f "$NLAST" "$NREQ"
  rm -f "$INGAME"; ds_reset
  [ "$AUTO_SWITCH" = "1" ] || apply "$PROFILE"
  ( sleep 20; load
    notify_state ) >/dev/null 2>&1 </dev/null &
  key=""; lastgame=""
  while :; do
    load
    thermal_guard
    if [ "$AUTO_SWITCH" = "1" ]; then
      pkg=$(fg_pkg)
      case "$pkg" in
        ""|com.android.systemui) ;;
        *)
          if grep -qxF "$pkg" "$GAMES"; then want="game:$pkg"; else want="daily"; fi
          if [ "$want" != "$key" ]; then
            if [ "$want" = "daily" ]; then
              [ -n "$lastgame" ] && gmode standard "$lastgame"
              lastgame=""; rm -f "$INGAME"; apply daily
            else
              [ -n "$lastgame" ] && gmode standard "$lastgame"
              echo "$pkg" > "$INGAME"; apply game; gmode performance "$pkg"; lastgame="$pkg"
            fi
            key="$want"
          fi;;
      esac
    else
      key=""
      if [ -f "$INGAME" ]; then rm -f "$INGAME"; ds_reset; fi
    fi
    i=0
    while [ "$i" -lt "${POLL:-4}" ]; do
      if [ -f "$NREQ" ]; then rm -f "$NREQ"; load; notify_state force; fi
      sleep 1; i=$((i+1))
    done
  done
}

# ---------- info ----------
status() {
  load
  echo "version=$(grep '^version=' "$MODDIR/module.prop" | cut -d= -f2)"
  echo "active=$(cat "$ACTIVE" 2>/dev/null || echo none)"
  echo "profile=$PROFILE"
  echo "auto=$AUTO_SWITCH"
  echo "dnd=$GAME_DND"
  echo "refresh_daily=$REFRESH_DAILY"
  echo "refresh_game=$REFRESH_GAME"
  echo "daemon=$(daemon_alive && echo 1 || echo 0)"
  echo "games=$(grep -c . "$GAMES")"
  [ -r "$SYS/sys/devices/system/cpu/cpufreq/policy0/scaling_governor" ] && \
    echo "governor=$(cat "$SYS/sys/devices/system/cpu/cpufreq/policy0/scaling_governor")"
  g=$(gpu_gov_path); [ -n "$g" ] && echo "gpu_governor=$(cat "$g")"
  echo "cpu_govs=$(cpu_avail | tr -s ' \n' ' ')"
  echo "gpu_govs=$(gpu_avail | tr -s ' \n' ' ')"
  echo "cpu_gov_daily=$CPU_GOV_DAILY"
  echo "cpu_gov_game=$CPU_GOV_GAME"
  echo "gpu_gov_daily=$GPU_GOV_DAILY"
  echo "gpu_gov_game=$GPU_GOV_GAME"
  echo "ds_now=$(cat "$DSP" 2>/dev/null || echo 100)"
  echo "thermal_off=$(th_active && echo 1 || echo 0)"
  echo "thermal_guard=$THERMAL_GUARD"
  echo "notify=$NOTIFY"
  echo "uilang=$UILANG"
  echo "swap_game=$SWAP_GAME"
  echo "vfs_game=$VFS_GAME"
  echo "tcp_game=$TCP_GAME"
  echo "tcp_now=$(cat "$SYS/proc/sys/net/ipv4/tcp_congestion_control" 2>/dev/null)"
  echo "tcp_avail=$(tcp_avail)"
  echo "summary=$(state_text)"
  echo "swappiness=$(cat "$SYS/proc/sys/vm/swappiness" 2>/dev/null)"
  echo "ram_free=$(meminfo MemAvailable)"
  echo "ram_total=$(meminfo MemTotal)"
  bt=$(batt_temp); [ -n "$bt" ] && echo "temp=$bt"
  [ -r "$SYS/sys/class/power_supply/battery/capacity" ] && echo "battery=$(cat "$SYS/sys/class/power_supply/battery/capacity")"
  echo "sdk=$SDK"
}

clean() {
  b=$(meminfo MemAvailable)
  am kill-all >/dev/null 2>&1
  sleep 1
  a=$(meminfo MemAvailable)
  log "clean RAM: ${b}MB -> ${a}MB"
  echo "Available RAM: ${b} MB -> ${a} MB"
}

bad() { echo "$1"; exit 1; }

case "$1" in
  status)  status;;
  profile)
    case "$2" in
      daily|game) setconf PROFILE "$2"; setconf AUTO_SWITCH 0; apply "$2" && echo "Profile $2 active (auto-switch turned off)";;
      *) echo "invalid profile"; exit 1;;
    esac;;
  set)
    k=$2; v=$3
    case "$k" in
      UILANG) case "$v" in en|id) ;; *) bad "invalid value";; esac;;
      AUTO_SWITCH|GAME_DND|NOTIFY) case "$v" in 0|1) ;; *) bad "invalid value";; esac;;
      REFRESH_DAILY|REFRESH_GAME) [ -z "$v" ] || isnum "$v" || bad "invalid value";;
      POLL) isnum "$v" && [ "$v" -ge 2 ] && [ "$v" -le 30 ] || bad "POLL 2-30";;
      CPU_GOV_DAILY|CPU_GOV_GAME) [ -z "$v" ] || inlist "$v" $(cpu_avail) || bad "CPU governor not available";;
      GPU_GOV_DAILY|GPU_GOV_GAME) [ -z "$v" ] || inlist "$v" $(gpu_avail) || bad "GPU governor not available";;
      THERMAL_GUARD) isnum "$v" && { [ "$v" -eq 0 ] || { [ "$v" -ge 40 ] && [ "$v" -le 60 ]; }; } || bad "Guard 0 or 40-60";;
      SWAP_GAME) isnum "$v" && [ "$v" -le 200 ] || bad "Swappiness 0-200";;
      VFS_GAME) isnum "$v" && [ "$v" -ge 1 ] && [ "$v" -le 500 ] || bad "Cache pressure 1-500";;
      TCP_GAME) [ -z "$v" ] || inlist "$v" $(tcp_avail) || bad "TCP algorithm not available";;
      *) bad "unknown key";;
    esac
    eval "ov=\${$k}"
    setconf "$k" "$v"; load
    case "$k" in
      REFRESH_*|GAME_DND|CPU_GOV_*|GPU_GOV_*|SWAP_GAME|VFS_GAME|TCP_GAME)
        a=$(cat "$ACTIVE" 2>/dev/null); [ -n "$a" ] && apply "$a";;
      NOTIFY) [ "$v" = "1" ] && notify_state force;;
    esac
    notify_state
    echo "OK";;
  thermal)
    case "$2" in
      stopped|stop|disable)
        thermal_disable || bad "No thermal services or sensors found"
        notify_state; echo "Thermal stopped";;
      running|start|enable)
        thermal_enable; notify_state; echo "Thermal running";;
      status) th_active && echo stopped || echo running;;
      *) bad "usage: thermal {stopped|running|status}";;
    esac;;
  notify)
    rm -f "$NLAST"
    if daemon_alive && notify_req; then echo OK
    elif notify "$(state_text)"; then echo OK; else echo "Could not post notification"; fi;;
  games)
    case "$2" in
      add)    okpkg "$3" || { echo "invalid package"; exit 1; }; grep -qxF "$3" "$GAMES" || echo "$3" >> "$GAMES"; echo OK;;
      remove) okpkg "$3" || { echo "invalid package"; exit 1; }; grep -vxF "$3" "$GAMES" > "$GAMES.t"; mv "$GAMES.t" "$GAMES"
              grep -v "^$3=" "$GAMERES" > "$GAMERES.t"; mv "$GAMERES.t" "$GAMERES"; echo OK;;
      res)    okpkg "$3" || { echo "invalid package"; exit 1; }
              grep -qxF "$3" "$GAMES" || { echo "Add the game to the list first"; exit 1; }
              isnum "$4" && [ "$4" -ge 30 ] && [ "$4" -le 100 ] || { echo "Resolution 30-100"; exit 1; }
              grep -v "^$3=" "$GAMERES" > "$GAMERES.t"; mv "$GAMERES.t" "$GAMERES"
              [ "$4" -lt 100 ] && echo "$3=$4" >> "$GAMERES"
              [ "$(cat "$INGAME" 2>/dev/null)" = "$3" ] && apply game
              echo OK;;
      resall) cat "$GAMERES";;
      *) cat "$GAMES";;
    esac;;
  installed) pm list packages -3 2>/dev/null | sed 's/^package://' | sort;;
  clean)     clean;;
  trimcache) pm trim-caches 999G >/dev/null 2>&1; log "trim cache"; echo "App caches cleared";;
  fstrim)
    ( for p in /data /cache /metadata /system /vendor /product /system_ext /odm; do fstrim "$p" >/dev/null 2>&1; done
      log "fstrim finished" ) >/dev/null 2>&1 </dev/null &
    log "fstrim started"; echo "Storage trim started in the background";;
  dexopt)
    ( cmd package compile -m speed-profile -a >> "$LOG" 2>&1; log "dexopt finished" ) >/dev/null 2>&1 </dev/null &
    log "dexopt started"; echo "Optimization started in the background (a few minutes)";;
  restore)   restore_all;;
  log)       tail -n 40 "$LOG" 2>/dev/null;;
  daemon)    daemon;;
  *) echo "usage: smoothplay {status|profile|set|thermal|notify|games|installed|clean|trimcache|fstrim|dexopt|restore|log|daemon}"; exit 1;;
esac
